# URL param value that unlocks /admin (?key=...). Leave blank to keep
# admin permanently locked. Even when set this is shipped in the JS
# bundle, so anyone with devtools can find it — it's a friction
# deterrent, not real auth.
NEXT_PUBLIC_ADMIN_KEY=
